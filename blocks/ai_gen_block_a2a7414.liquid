{% doc %}
  @prompt
    Make product slider,display 5 products
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-product-slider-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-slider-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 30px;
  }

  .ai-product-slider-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
    font-weight: 700;
  }

  .ai-product-slider-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-product-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-product-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    transition: transform 0.4s ease;
  }

  .ai-product-slider-item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.product_gap }}px * 4)) / 5);
    min-width: 0;
  }

  .ai-product-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-product-info-{{ ai_gen_id }} {
    padding: 16px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 700;
    color: {{ block.settings.product_price_color }};
    margin-top: auto;
  }

  .ai-product-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
    height: 100%;
  }

  .ai-slider-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: {{ block.settings.nav_button_color }};
    border: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background-color 0.3s ease, opacity 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .ai-slider-nav-{{ ai_gen_id }}:hover {
    background: {{ block.settings.nav_button_hover_color }};
  }

  .ai-slider-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-slider-nav-{{ ai_gen_id }}.prev {
    left: -22px;
  }

  .ai-slider-nav-{{ ai_gen_id }}.next {
    right: -22px;
  }

  .ai-slider-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.nav_icon_color }};
  }

  .ai-slider-dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .ai-slider-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .ai-slider-dot-{{ ai_gen_id }}.active {
    background: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  @media screen and (max-width: 989px) {
    .ai-product-slider-item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.product_gap }}px * 2)) / 3);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-product-slider-item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.product_gap }}px) / 2);
    }

    .ai-slider-nav-{{ ai_gen_id }}.prev {
      left: 10px;
    }

    .ai-slider-nav-{{ ai_gen_id }}.next {
      right: 10px;
    }

    .ai-product-slider-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }
  }
{% endstyle %}

<product-slider-{{ ai_gen_id }} class="ai-product-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-slider-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-product-slider-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-product-slider-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-product-slider-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-product-slider-wrapper-{{ ai_gen_id }}">
      <button class="ai-slider-nav-{{ ai_gen_id }} prev" aria-label="Previous products">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
      </button>

      <div class="ai-product-slider-track-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% assign product_key = 'product_' | append: i %}
          {% assign product = block.settings[product_key] %}
          
          <div class="ai-product-slider-item-{{ ai_gen_id }}">
            {% if product != blank %}
              <a href="{{ product.url }}" class="ai-product-link-{{ ai_gen_id }}">
                <div class="ai-product-card-{{ ai_gen_id }}">
                  <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        class="ai-product-image-{{ ai_gen_id }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% else %}
                      <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  <div class="ai-product-info-{{ ai_gen_id }}">
                    <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                    <div class="ai-product-price-{{ ai_gen_id }}">{{ product.price | money }}</div>
                  </div>
                </div>
              </a>
            {% else %}
              <div class="ai-product-card-{{ ai_gen_id }}">
                <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                  <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                </div>
                <div class="ai-product-info-{{ ai_gen_id }}">
                  <h3 class="ai-product-title-{{ ai_gen_id }}">Product {{ i }}</h3>
                  <div class="ai-product-price-{{ ai_gen_id }}">$0.00</div>
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <button class="ai-slider-nav-{{ ai_gen_id }} next" aria-label="Next products">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>
    </div>

    {% if block.settings.show_dots %}
      <div class="ai-slider-dots-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</product-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.itemsPerView = 5;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-product-slider-track-{{ ai_gen_id }}');
        this.items = this.querySelectorAll('.ai-product-slider-item-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-slider-nav-{{ ai_gen_id }}.prev');
        this.nextButton = this.querySelector('.ai-slider-nav-{{ ai_gen_id }}.next');
        this.dotsContainer = this.querySelector('.ai-slider-dots-{{ ai_gen_id }}');
        
        this.updateItemsPerView();
        this.setupEventListeners();
        this.createDots();
        this.updateSlider();
        
        window.addEventListener('resize', () => {
          this.updateItemsPerView();
          this.createDots();
          this.updateSlider();
        });
      }

      updateItemsPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.itemsPerView = 2;
        } else if (width <= 989) {
          this.itemsPerView = 3;
        } else {
          this.itemsPerView = 5;
        }
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());
      }

      createDots() {
        if (!this.dotsContainer) return;
        
        this.dotsContainer.innerHTML = '';
        const totalDots = Math.ceil(this.items.length / this.itemsPerView);
        
        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-slider-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          if (i === 0) dot.classList.add('active');
          
          dot.addEventListener('click', () => {
            this.currentIndex = i * this.itemsPerView;
            this.updateSlider();
          });
          
          this.dotsContainer.appendChild(dot);
        }
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex = Math.max(0, this.currentIndex - this.itemsPerView);
          this.updateSlider();
        }
      }

      next() {
        const maxIndex = this.items.length - this.itemsPerView;
        if (this.currentIndex < maxIndex) {
          this.currentIndex = Math.min(maxIndex, this.currentIndex + this.itemsPerView);
          this.updateSlider();
        }
      }

      updateSlider() {
        const itemWidth = this.items[0].offsetWidth;
        const gap = {{ block.settings.product_gap }};
        const offset = -(this.currentIndex * (itemWidth + gap));
        
        this.track.style.transform = 'translateX(' + offset + 'px)';
        
        const maxIndex = this.items.length - this.itemsPerView;
        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= maxIndex;
        
        if (this.dotsContainer) {
          const dots = this.dotsContainer.querySelectorAll('.ai-slider-dot-{{ ai_gen_id }}');
          const activeDotIndex = Math.floor(this.currentIndex / this.itemsPerView);
          
          dots.forEach((dot, index) => {
            if (index === activeDotIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }
      }
    }

    customElements.define('product-slider-{{ ai_gen_id }}', ProductSlider{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product slider",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
