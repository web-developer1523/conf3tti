<section class="collection-grid-section">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="collection-grid-heading text-{{ section.settings.text_alignment }}">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="collection-grid-description text-{{ section.settings.text_alignment }}">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    <div class="collection-grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          <a href="{{ product.url }}" class="collection-item">

            <div class="collection-image-wrapper">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.title }}"
                  loading="lazy"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}

              <div class="collection-overlay">
                <div class="collection-title">
                  {{ product.title }}<br>
                  <span class="product-price">
                    {{ product.price | money }}
                  </span>
                </div>
              </div>
            </div>

          </a>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>
<style>.collection-grid-section {
  padding: 60px 0;
}

.collection-grid-heading {
  font-size: 32px;
  font-weight: 700;
  margin-bottom: 10px;
}

.collection-grid-description {
  font-size: 16px;
  color: #666;
  margin-bottom: 40px;
  max-width: 700px;
}

/* Alignment helpers */
.text-left { text-align: left; }
.text-center { text-align: center; margin-left: auto; margin-right: auto; }
.text-right { text-align: right; margin-left: auto; }

.collection-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 20px;
}

.collection-item {
  text-decoration: none;
  color: inherit;
}

.collection-image-wrapper {
  position: relative;
  overflow: hidden;
  border-radius: 8px;
}

.collection-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.collection-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.collection-title {
  color: #fff;
  font-size: 18px;
  font-weight: 600;
  text-align: center;
  padding: 10px;
}

.product-price {
  font-size: 14px;
  font-weight: 400;
}

.collection-image-wrapper:hover .collection-overlay {
  opacity: 1;
}

/* Responsive */
@media (max-width: 1200px) {
  .collection-grid { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 768px) {
  .collection-grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 480px) {
  .collection-grid { grid-template-columns: 1fr; }
}
</style>
{% schema %}
{
  "name": "5 Column Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse our best sellers"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Heading & Subheading Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select product"
        }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    {
      "name": "5 Column Product Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
