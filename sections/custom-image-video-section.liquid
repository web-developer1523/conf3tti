{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
.image-video-flex {
  display: flex;
  align-items: center;
  gap: 40px;
  flex-wrap: wrap;
}
.image-video-reverse {
  flex-direction: row-reverse;
}
.image-block img {
  width: 100%;
  border-radius: 6px;
}
.image-text-content {
  max-width: 480px;
  margin-top: 20px;
}
.top-heading {
  text-align: center;
  margin-bottom: 45px;
}
.video-player {
  width: 100%;
  height: auto;
  border-radius: 6px;
}
{%- endstyle -%}

<section class="section-{{ section.id }}-padding page-width {{ section.settings.custom_class }}">

  {% if section.settings.top_heading != blank %}
    <div class="top-heading">
      {{ section.settings.top_heading }}
    </div>
  {% endif %}

  <div class="image-video-flex {% if section.settings.reverse_layout %}image-video-reverse{% endif %}">
    
    <!-- LEFT: IMAGE + TEXT -->
    <div class="image-block" style="flex:1;">
      {% if section.settings.image %}
        <img src="{{ section.settings.image | img_url: 'master' }}" alt="">
      {% endif %}

      <div class="image-text-content">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div>{{ section.settings.description }}</div>
        {% endif %}
        {% if section.settings.button_label != blank and section.settings.button_url != blank %}
          <a href="{{ section.settings.button_url }}" class="button">{{ section.settings.button_label }}</a>
        {% endif %}
      </div>
    </div>

    <!-- RIGHT: SHOPIFY VIDEO ONLY -->
   <div class="video-block" style="flex:1;">
  {% if section.settings.video %}
    {{
      section.settings.video
      | video_tag:
        autoplay: true,
        loop: section.settings.enable_video_looping,
        controls: true,
        muted: false,
        class: "video-player"
    }}
  {% endif %}
</div>
  </div>
</section>


{% schema %}
{
  "name": "Image + Text + Video",
  "settings": [
      {
      "type":"text",
      "id":"custom_class",
      "label":"custom class"
    },
    {
      "type": "richtext",
      "id": "top_heading",
      "label": "Top Rich Heading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },

    { "type": "header", "content": "Video Settings" },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify Hosted Video"
    },
    {
      "type": "checkbox",
      "id": "enable_video_looping",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Swap sides (video ↔ image)",
      "default": false
    },

    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 140, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [
    { "name": "Image + Text + Video" }
  ]
}
{% endschema %}
