<style>
.worth_main {
  width: 100%;
}
.worth_data {
  width: 100%;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 30px 0 25px;
}
.worth_flex {
  width: 100%;
  display: flex;
  align-items: end;
  gap: 0 120px;
  border-bottom: 1.02px solid {{ section.settings.border_color }};
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
.worth_left {
  width: 50%;
  display: flex;
  align-items: end;
  gap: 0 18px;
}
.worth_right {
  width: 50%;
}
.worth_one img {
  width: 100%;
  max-width: 352px;
  object-fit: cover;
  margin-bottom: -10px;
}
.worth_two img {
  width: 100%;
  max-width: 181px;
  object-fit: cover;
  margin-bottom: -10px;
}
.worth_text_container {
  width: 100%;
  margin-bottom: 5px;
}
.worth_heading {
  width: 100%;
  max-width: 500px;
}
.worth_heading h1 {
  font-weight: 600;
  font-size: 60px;
  line-height: 1;
  color: {{ section.settings.text_color }};
  margin: 0;
  letter-spacing: 1px;
}
.worth_para {
  margin-top: 25px;
  width: 100%;
  max-width: 381px;
}
.worth_para p {
 font-family: 'Helvetica' !important;
    font-weight: 400;
    font-size: 16px;
  line-height: 1.3;
  color: {{ section.settings.text_color }};
  margin: 0;
}

@media (max-width: 1100px) {
  .worth_heading h1 {
    font-size: 48px;
  }
}
@media (max-width: 950px) {
  .worth_data {
    padding: 0px 20px 60px 20px;
  }
  .worth_flex{
    gap: 0 100px;
    padding-bottom: 50px;
    margin-top: -30px;
  }
  .worth_text_container {
    margin-bottom: 0;
  }
  .worth_heading h1 {
    font-size: 35px;
  }
  .worth_para p {
    font-size: 16px;
  }
}
@media (max-width: 767px) {
  .worth_flex {
    flex-direction: column-reverse;
    align-items: flex-end;
    margin-top: 0;
  }
  .worth_heading {
    margin-top: 120px;
  }
  .worth_heading h1 {
    font-size: 32px;
  }
  .worth_para {
    margin-top: 15px;
  }
  .worth_right {
    width: 50%;
  }
  .worth_left {
    width: 100%;
    margin-top: 70px;
  }
  .worth_one img {
    max-width: 500px;
  }
  .worth_data {
    padding: 80px 20px 60px 20px;
  }
}
@media (max-width: 550px) {
  .worth_right {
    width: 75%;
  }
  .worth_left {
    margin-top: 45px;
  }
  .worth_heading {
    margin-top: 100px;
  }
  .worth_heading h1 {
    font-size: 27px;
  }
  .worth_flex {
    padding-bottom: 50px;
  }
}
</style>

<div class="worth_main">
  <div class="worth_data">
    <div class="worth_flex">
      <div class="worth_left">
        {% if section.settings.image_large %}
          <div class="worth_one" data-aos="slide-up" data-aos-once="true" data-aos-duration="1500">
            <img src="{{ section.settings.image_large | image_url }}" alt="{{ section.settings.image_large.alt }}" />
          </div>
        {% endif %}
        {% if section.settings.image_small %}
          <div class="worth_two" data-aos="slide-up" data-aos-once="true" data-aos-duration="1500">
            <img src="{{ section.settings.image_small | image_url }}" alt="{{ section.settings.image_small.alt }}" />
          </div>
        {% endif %}
      </div>
      
      <div class="worth_right">
        <div class="worth_text_container">
          <div class="worth_heading" data-aos="slide-up" data-aos-once="true" data-aos-duration="1500">
            <h1>{{ section.settings.heading }}</h1>
          </div>
          {% if section.settings.paragraph != blank %}
            <div class="worth_para" data-aos="slide-up" data-aos-once="true" data-aos-duration="1500">
              <p>{{ section.settings.paragraph }}</p>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Worth Wearing Out",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WORTH WEARING OUT"
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph Text",
      "default": "Elevate your brand merch to a retail-quality daily staple anyone would rep."
    },
    {
      "type": "image_picker",
      "id": "image_large",
      "label": "Large Image"
    },
    {
      "type": "image_picker",
      "id": "image_small",
      "label": "Small Image"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#c4c7c7"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Worth Wearing Out",
      "category": "Image with Text"
    }
  ]
}
{% endschema %}