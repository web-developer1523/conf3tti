{% style %}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}
.four-col-wrapper {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}
.four-col-item img {
  width: 100%;
  border-radius: 6px;
  transition: transform 0.3s ease; /* Smooth zoom transition */
}
.four-col-item img:hover {
  transform: scale(1.1); /* Zoom in slightly */
}
.four-col-item-title {
  text-align: center;
  margin-top: 12px;
  font-size: 16px;
}
.four-col-item-title a {
  color: inherit;
  text-decoration: none;
}
.four-col-item-title a:hover {
  text-decoration: underline;
}
.top-section-heading {
  text-align: center;
  margin-bottom: 40px;
}

/* Responsive */
@media (max-width: 992px) {
  .four-col-wrapper {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 600px) {
  .four-col-wrapper {
    grid-template-columns: repeat(1, 1fr);
  }
}
{% endstyle %}}

<section class="section-{{ section.id }}-padding page-width">

  {% if section.settings.top_heading != blank %}
    <h2 class="top-section-heading">{{ section.settings.top_heading }}</h2>
  {% endif %}

  <div class="four-col-wrapper">
    {% for block in section.blocks %}
      <div class="four-col-item">
        {% if block.settings.image %}
          <a href="{{ block.settings.link }}">
            <img src="{{ block.settings.image | img_url: 'master' }}" alt="">
          </a>
        {% endif %}

        {% if block.settings.title != blank %}
          <div class="four-col-item-title">
            <a href="{{ block.settings.link }}">
              {{ block.settings.title }}
            </a>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

</section>

{% schema %}
{
  "name": "4 Column Image Grid",
  "settings": [
    {
      "type": "text",
      "id": "top_heading",
      "label": "Top Heading",
      "default": "Don't stop at one perfect present."
    },
        {
    "type": "range",
    "id": "padding_top",
    "label": "Padding top",
    "min": 0,
    "max": 120,
    "step": 4,
    "unit": "px",
    "default": 48
    },
    {
    "type": "range",
    "id": "padding_bottom",
    "label": "Padding bottom",
    "min": 0,
    "max": 120,
    "step": 4,
    "unit": "px",
    "default": 48
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Text below image",
          "default": "Women's Matching Sets"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link URL"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "4 Column Image Grid" }
  ]
}
{% endschema %}
