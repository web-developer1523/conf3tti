{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .spotlight-collections__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }
  .spotlight-collections__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .spotlight-collections__link img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .spotlight-collections__title {
    display: block;
    margin-top: 0.5rem;
    font-weight: 600;
  }
{%- endstyle -%}
<div class="spotlight-collections page-width section-{{ section.id }}-padding">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="spotlight-collections__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="spotlight-collections__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="spotlight-collections__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="spotlight-collections__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'collection' -%}
        {%- assign col = block.settings.collection -%}
        {%- assign block_image = block.settings.image -%}
        {%- assign block_title = block.settings.title -%}
        {%- assign display_title = block_title | default: col.title -%}
        {%- assign link_url = col.url | default: '#' -%}
        <div class="spotlight-collections__item" {{ block.shopify_attributes }}>
          {%- if col != blank or block_title != blank -%}
            <a href="{{ link_url }}" class="spotlight-collections__link">
              {%- if block_image != blank -%}
                {{ block_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: display_title }}
              {%- elsif col != blank and col.featured_image != blank -%}
                {{ col.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: display_title }}
              {%- endif -%}
              <span class="spotlight-collections__title">{{ display_title }}</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Spotlight Collections",
  "tag": "section",
  "class": "section-spotlight-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SPOTLIGHT"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Classic silhouettes and cutting-edge innovation"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional, uses collection image if blank)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title (optional, uses collection title if blank)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spotlight Collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
