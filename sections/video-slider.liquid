      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Reactions, Real Love for Candynavia!"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Navigation Arrow Color",
      "default": "#29b1c3"
    },
    {
      "type": "range",
      "id": "desktop_slides",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Slides Per View (Desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_slides",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Slides Per View (Tablet)",
      "default": 3
    },
    {
      "type": "range",
      "id": "mobile_slides",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Slides Per View (Mobile)",
      "default": 1
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "text",
          "id": "mp4_url",
          "label": "MP4 Video URL",
          "info": "Upload MP4 video to Shopify Files and paste URL here"
        },
        {
          "type": "text",
          "id": "webm_url",
          "label": "WebM Video URL",
          "info": "Upload WebM video to Shopify Files and paste URL here"
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail Image",
          "info": "Optional - Displayed before video plays"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Testimonials Slider",
      "category": "Custom",
      "blocks": [
        {
          "type": "video"
        },
        {
          "type": "video"
        },
        {
          "type": "video"
        },
        {
          "type": "video"
        }
      ]
    }
  ]
}
{% endschema %}